<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="20" style="-fx-padding: 30;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tg.univlome.epl.gestionboutique.controller.HistoriqueController">

    <HBox alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label text="Historique des ventes" styleClass="topbar-title"/>
            <Label text="Consultez toutes les ventes enregistrées" style="-fx-text-fill: #64748B; -fx-font-size: 12.5px;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Exporter (Excel/CSV)" styleClass="btn-secondary" onAction="#handleExporterCsv" graphicTextGap="8">
            <graphic><FontIcon iconLiteral="fth-download" iconSize="14"/></graphic>
        </Button>
    </HBox>

    <VBox styleClass="content-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="tableVentes" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="N° Vente" prefWidth="90"/>
                <TableColumn fx:id="colDate" text="Date" prefWidth="180"/>
                <TableColumn fx:id="colVendeur" text="Vendeur" prefWidth="200"/>
                <TableColumn fx:id="colTotal" text="Total" prefWidth="150"/>
                <TableColumn fx:id="colDetail" text="Détail" prefWidth="120"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
