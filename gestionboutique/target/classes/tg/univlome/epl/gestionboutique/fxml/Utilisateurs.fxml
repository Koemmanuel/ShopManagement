<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" style="-fx-padding: 30;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tg.univlome.epl.gestionboutique.controller.UtilisateursController">

    <HBox alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label text="Gestion des utilisateurs" styleClass="topbar-title"/>
            <Label text="Ajoutez des comptes vendeur ou administrateur" style="-fx-text-fill: #64748B; -fx-font-size: 12.5px;"/>
        </VBox>
    </HBox>

    <HBox styleClass="content-card" spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="txtNomComplet" promptText="Nom complet" prefWidth="180"/>
        <TextField fx:id="txtIdentifiant" promptText="Identifiant" prefWidth="150"/>
        <PasswordField fx:id="txtMotDePasse" promptText="Mot de passe" prefWidth="150"/>
        <ComboBox fx:id="cmbRole" prefWidth="140" promptText="Rôle"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Ajouter" styleClass="btn-primary" onAction="#handleAjouter"/>
    </HBox>

    <VBox styleClass="content-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="tableUtilisateurs" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNomComplet" text="Nom complet" prefWidth="220"/>
                <TableColumn fx:id="colIdentifiant" text="Identifiant" prefWidth="160"/>
                <TableColumn fx:id="colRole" text="Rôle" prefWidth="130"/>
                <TableColumn fx:id="colActions" text="Actions" prefWidth="120"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
