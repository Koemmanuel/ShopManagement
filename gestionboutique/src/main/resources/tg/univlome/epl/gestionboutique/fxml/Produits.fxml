<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" style="-fx-padding: 30;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tg.univlome.epl.gestionboutique.controller.ProduitsController">

    <HBox alignment="CENTER_LEFT">
        <VBox spacing="2">
            <Label text="Gestion des produits" styleClass="topbar-title"/>
            <Label text="Ajoutez, modifiez ou supprimez les produits de votre boutique" style="-fx-text-fill: #64748B; -fx-font-size: 12.5px;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Nouveau produit" styleClass="btn-primary" onAction="#handleNouveauProduit"/>
    </HBox>

    <HBox styleClass="content-card" spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="txtRecherche" promptText="Rechercher un produit par nom ou catégorie..." prefWidth="350" onKeyReleased="#handleRecherche"/>
    </HBox>

    <VBox styleClass="content-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="tableProduits" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNom" text="Nom" prefWidth="200"/>
                <TableColumn fx:id="colCategorie" text="Catégorie" prefWidth="130"/>
                <TableColumn fx:id="colPrixAchat" text="Prix d'achat" prefWidth="110"/>
                <TableColumn fx:id="colPrixVente" text="Prix de vente" prefWidth="110"/>
                <TableColumn fx:id="colStock" text="Stock" prefWidth="90"/>
                <TableColumn fx:id="colStatut" text="Statut" prefWidth="120"/>
                <TableColumn fx:id="colActions" text="Actions" prefWidth="160"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
